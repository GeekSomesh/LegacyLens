      <requiredDecision href="#d_WS_RISK_FLAG_v2" />
    </informationRequirement>
    <literalExpression id="d_WS_RISK_FLAG_v3_e">
      <text>if TX_COUNTRY != TX_HOME then if TX_COUNTRY = "X2" then "Y" else WS_RISK_FLAG_v2 else WS_RISK_FLAG_v2</text>
