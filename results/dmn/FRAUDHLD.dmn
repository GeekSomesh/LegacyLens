  <decision id="d_WS_RISK_FLAG" name="WS_RISK_FLAG">
    <variable id="d_WS_RISK_FLAG_v" name="WS_RISK_FLAG" typeRef="string" />
    <literalExpression id="d_WS_RISK_FLAG_e">
      <text>"N"</text>
    </literalExpression>
  </decision>
  <decision id="d_WS_RISK_FLAG_v2" name="WS_RISK_FLAG_v2">
    <variable id="d_WS_RISK_FLAG_v2_v" name="WS_RISK_FLAG_v2" typeRef="string" />
    <informationRequirement id="ir_WS_RISK_FLAG_v2_TX_COUNTRY">
      <requiredInput href="#in_TX_COUNTRY" />
    </informationRequirement>
    <informationRequirement id="ir_WS_RISK_FLAG_v2_TX_HOME">
      <requiredInput href="#in_TX_HOME" />
    </informationRequirement>
    <informationRequirement id="ir_WS_RISK_FLAG_v2_WS_RISK_FLAG">
      <requiredDecision href="#d_WS_RISK_FLAG" />
    </informationRequirement>
    <literalExpression id="d_WS_RISK_FLAG_v2_e">
      <text>if TX_COUNTRY != TX_HOME then if TX_COUNTRY = "X1" then "Y" else WS_RISK_FLAG else WS_RISK_FLAG</text>
    </literalExpression>
  </decision>
  <decision id="d_WS_RISK_FLAG_v3" name="WS_RISK_FLAG_v3">
