  <decision id="d_WS_RATIO" name="WS_RATIO">
    <variable id="d_WS_RATIO_v" name="WS_RATIO" typeRef="number" />
    <informationRequirement id="ir_WS_RATIO_TX_AMOUNT">
      <requiredInput href="#in_TX_AMOUNT" />
    </informationRequirement>
    <informationRequirement id="ir_WS_RATIO_TX_AVG_30D">
      <requiredInput href="#in_TX_AVG_30D" />
    </informationRequirement>
    <literalExpression id="d_WS_RATIO_e">
      <text>if TX_AVG_30D = 0 then (modulo(abs((if (99999.99) * 100 &gt;= 0 then floor((99999.99) * 100) else ceiling((99999.99) * 100))), 10000000)) / 100 else (modulo(abs((if ((TX_AMOUNT / TX_AVG_30D)) * 100 &gt;= 0 then floor(((TX_AMOUNT / TX_AVG_30D)) * 100) else ceiling(((TX_AMOUNT / TX_AVG_30D)) * 100))), 10000000)) / 100</text>
    </literalExpression>
  </decision>
