    <literalExpression id="d_WS_RISK_FLAG_v4_e">
      <text>if TX_COUNTRY != TX_HOME then if TX_COUNTRY = "X3" then "Y" else WS_RISK_FLAG_v3 else WS_RISK_FLAG_v3</text>
