<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" id="defs_CREDREV" name="CREDREV" namespace="https://legacylens.example/CREDREV" expressionLanguage="https://www.omg.org/spec/DMN/20191111/FEEL/">
  <inputData id="in_IN_ACCT" name="IN_ACCT">
    <variable id="in_IN_ACCT_v" name="IN_ACCT" typeRef="number" />
  </inputData>
  <inputData id="in_IN_LIMIT" name="IN_LIMIT">
    <variable id="in_IN_LIMIT_v" name="IN_LIMIT" typeRef="number" />
  </inputData>
