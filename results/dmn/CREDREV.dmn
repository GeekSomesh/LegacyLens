  <decision id="c_WS_HIGH_LIMIT" name="WS_HIGH_LIMIT">
    <variable id="c_WS_HIGH_LIMIT_v" name="WS_HIGH_LIMIT" typeRef="number" />
    <literalExpression id="c_WS_HIGH_LIMIT_e">
      <text>500000</text>
    </literalExpression>
  </decision>
  <decision id="d_WS_UTIL_0" name="WS_UTIL">
    <variable id="d_WS_UTIL_0_v" name="WS_UTIL" typeRef="number" />
    <informationRequirement id="ir_WS_UTIL_0_IN_BILL">
      <requiredInput href="#in_IN_BILL" />
    </informationRequirement>
    <informationRequirement id="ir_WS_UTIL_0_IN_LIMIT">
      <requiredInput href="#in_IN_LIMIT" />
    </informationRequirement>
    <literalExpression id="d_WS_UTIL_0_e">
      <text>if IN_LIMIT = 0 then modulo(abs((if (999) &gt;= 0 then floor((999)) else ceiling((999)))), 100000) else modulo(abs((if (((IN_BILL * 100) / IN_LIMIT)) &gt;= 0 then floor((((IN_BILL * 100) / IN_LIMIT))) else ceiling((((IN_BILL * 100) / IN_LIMIT))))), 100000)</text>
    </literalExpression>
  </decision>
  <decision id="d_WS_MIN_DUE_1" name="WS_MIN_DUE">
    <variable id="d_WS_MIN_DUE_1_v" name="WS_MIN_DUE" typeRef="number" />
    <informationRequirement id="ir_WS_MIN_DUE_1_IN_BILL">
      <requiredInput href="#in_IN_BILL" />
    </informationRequirement>
    <literalExpression id="d_WS_MIN_DUE_1_e">
      <text>modulo(abs((if ((IN_BILL / 10)) &gt;= 0 then floor(((IN_BILL / 10))) else ceiling(((IN_BILL / 10))))), 10000000)</text>
    </literalExpression>
  </decision>
  <decision id="d_WS_SEVERITY_2" name="WS_SEVERITY">
    <variable id="d_WS_SEVERITY_2_v" name="WS_SEVERITY" typeRef="number" />
    <informationRequirement id="ir_WS_SEVERITY_2_IN_DELINQ">
      <requiredInput href="#in_IN_DELINQ" />
    </informationRequirement>
    <literalExpression id="d_WS_SEVERITY_2_e">
      <text>modulo(abs((if (IN_DELINQ) &gt;= 0 then floor((IN_DELINQ)) else ceiling((IN_DELINQ)))), 10)</text>
    </literalExpression>
  </decision>
