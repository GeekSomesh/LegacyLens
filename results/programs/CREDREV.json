{
 "name": "CREDREV",
 "origin": "Credit line review policy written for LegacyLens",
 "path": "cobol/CREDREV.cbl",
 "lines": [
  {
   "no": 1,
   "text": "      *================================================================*"
  },
  {
   "no": 2,
   "text": "      * CREDREV  - MONTHLY CREDIT LINE REVIEW                          *"
  },
  {
   "no": 3,
   "text": "      * Batch policy program. Reads a count, then one account summary  *"
  },
  {
   "no": 4,
   "text": "      * per line, and writes one decision line per account:            *"
  },
  {
   "no": 5,
   "text": "      *   ACCOUNT DECISION REASON UTILISATION                          *"
  },
  {
   "no": 6,
   "text": "      * Record layout (29 bytes):                                      *"
  },
  {
   "no": 7,
   "text": "      *   ACCT 9(6) LIMIT 9(7) BILL 9(7) PAID 9(7) DELINQ 9 LATE-6M 9  *"
  },
  {
   "no": 8,
   "text": "      *================================================================*"
  },
  {
   "no": 9,
   "text": "       IDENTIFICATION DIVISION."
  },
  {
   "no": 10,
   "text": "       PROGRAM-ID. CREDREV."
  },
  {
   "no": 11,
   "text": "       DATA DIVISION."
  },
  {
   "no": 12,
   "text": "       WORKING-STORAGE SECTION."
  },
  {
   "no": 13,
   "text": "       01  WS-COUNT              PIC 9(6)."
  },
  {
   "no": 14,
   "text": "       01  IN-REC."
  },
  {
   "no": 15,
   "text": "           05  IN-ACCT           PIC 9(6)."
  },
  {
   "no": 16,
   "text": "           05  IN-LIMIT          PIC 9(7)."
  },
  {
   "no": 17,
   "text": "           05  IN-BILL           PIC 9(7)."
  },
  {
   "no": 18,
   "text": "           05  IN-PAID           PIC 9(7)."
  },
  {
   "no": 19,
   "text": "           05  IN-DELINQ         PIC 9."
  },
  {
   "no": 20,
   "text": "           05  IN-LATE-6M        PIC 9."
  },
  {
   "no": 21,
   "text": "       01  WS-UTIL               PIC 9(5)."
  },
  {
   "no": 22,
   "text": "       01  WS-MIN-DUE            PIC 9(7)."
  },
  {
   "no": 23,
   "text": "       01  WS-HIGH-LIMIT         PIC 9(7)  VALUE 500000."
  },
  {
   "no": 24,
   "text": "       01  OUT-DECISION          PIC X(8)."
  },
  {
   "no": 25,
   "text": "       01  OUT-REASON            PIC X(3)."
  },
  {
   "no": 26,
   "text": "       01  WS-SEVERITY           PIC 9."
  },
  {
   "no": 27,
   "text": "           88  SEVERELY-LATE     VALUE 3 THRU 9."
  },
  {
   "no": 28,
   "text": "       PROCEDURE DIVISION."
  },
  {
   "no": 29,
   "text": "       MAIN-PARA."
  },
  {
   "no": 30,
   "text": "           ACCEPT WS-COUNT"
  },
  {
   "no": 31,
   "text": "           PERFORM REVIEW-ACCOUNT WS-COUNT TIMES"
  },
  {
   "no": 32,
   "text": "           STOP RUN."
  },
  {
   "no": 33,
   "text": ""
  },
  {
   "no": 34,
   "text": "       REVIEW-ACCOUNT."
  },
  {
   "no": 35,
   "text": "           ACCEPT IN-REC"
  },
  {
   "no": 36,
   "text": "           PERFORM COMPUTE-RATIOS"
  },
  {
   "no": 37,
   "text": "           PERFORM APPLY-POLICY"
  },
  {
   "no": 38,
   "text": "           DISPLAY IN-ACCT ' ' OUT-DECISION ' ' OUT-REASON ' '"
  },
  {
   "no": 39,
   "text": "                   WS-UTIL."
  },
  {
   "no": 40,
   "text": ""
  },
  {
   "no": 41,
   "text": "       COMPUTE-RATIOS."
  },
  {
   "no": 42,
   "text": "      *    Utilisation in percent of the credit limit."
  },
  {
   "no": 43,
   "text": "           IF IN-LIMIT = 0"
  },
  {
   "no": 44,
   "text": "               MOVE 999 TO WS-UTIL"
  },
  {
   "no": 45,
   "text": "           ELSE"
  },
  {
   "no": 46,
   "text": "               COMPUTE WS-UTIL = IN-BILL * 100 / IN-LIMIT"
  },
  {
   "no": 47,
   "text": "           END-IF"
  },
  {
   "no": 48,
   "text": "      *    Minimum payment due is 10 percent of the statement."
  },
  {
   "no": 49,
   "text": "           COMPUTE WS-MIN-DUE = IN-BILL / 10"
  },
  {
   "no": 50,
   "text": "           MOVE IN-DELINQ TO WS-SEVERITY."
  },
  {
   "no": 51,
   "text": ""
  },
  {
   "no": 52,
   "text": "       APPLY-POLICY."
  },
  {
   "no": 53,
   "text": "           IF SEVERELY-LATE"
  },
  {
   "no": 54,
   "text": "               MOVE 'BLOCK' TO OUT-DECISION"
  },
  {
   "no": 55,
   "text": "               MOVE 'R01' TO OUT-REASON"
  },
  {
   "no": 56,
   "text": "           ELSE"
  },
  {
   "no": 57,
   "text": "               IF IN-DELINQ >= 1 AND WS-UTIL > 90"
  },
  {
   "no": 58,
   "text": "                   MOVE 'REVIEW' TO OUT-DECISION"
  },
  {
   "no": 59,
   "text": "                   MOVE 'R02' TO OUT-REASON"
  },
  {
   "no": 60,
   "text": "               ELSE"
  },
  {
   "no": 61,
   "text": "                   EVALUATE TRUE"
  },
  {
   "no": 62,
   "text": "                       WHEN IN-LATE-6M >= 3"
  },
  {
   "no": 63,
   "text": "                           MOVE 'DECREASE' TO OUT-DECISION"
  },
  {
   "no": 64,
   "text": "                           MOVE 'R03' TO OUT-REASON"
  },
  {
   "no": 65,
   "text": "                       WHEN IN-PAID < WS-MIN-DUE AND WS-UTIL > 80"
  },
  {
   "no": 66,
   "text": "                           MOVE 'REVIEW' TO OUT-DECISION"
  },
  {
   "no": 67,
   "text": "                           MOVE 'R04' TO OUT-REASON"
  },
  {
   "no": 68,
   "text": "                       WHEN IN-LATE-6M = 0 AND WS-UTIL < 30"
  },
  {
   "no": 69,
   "text": "                            AND IN-LIMIT < WS-HIGH-LIMIT"
  },
  {
   "no": 70,
   "text": "                           MOVE 'INCREASE' TO OUT-DECISION"
  },
  {
   "no": 71,
   "text": "                           MOVE 'R05' TO OUT-REASON"
  },
  {
   "no": 72,
   "text": "                       WHEN OTHER"
  },
  {
   "no": 73,
   "text": "                           MOVE 'KEEP' TO OUT-DECISION"
  },
  {
   "no": 74,
   "text": "                           MOVE 'R06' TO OUT-REASON"
  },
  {
   "no": 75,
   "text": "                   END-EVALUATE"
  },
  {
   "no": 76,
   "text": "               END-IF"
  },
  {
   "no": 77,
   "text": "           END-IF."
  }
 ],
