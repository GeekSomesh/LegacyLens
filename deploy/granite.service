# systemd user unit for the IBM Granite LLM (llama.cpp server, big-endian GGUF) on LinuxONE.
#   mkdir -p ~/.config/systemd/user && cp deploy/granite.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now granite
#   sudo loginctl enable-linger $USER      # keep user services running after logout
[Unit]
Description=IBM Granite 3.3 2B Instruct (llama.cpp) for LegacyLens explanations

[Service]
ExecStart=%h/work/llama.cpp/build/bin/llama-server -m %h/models/granite-3.3-2b-instruct-be.Q4_0.gguf --host 127.0.0.1 --port 8080 -c 4096 -t 3 --alias granite-3.3-2b-instruct
Restart=on-failure

[Install]
WantedBy=default.target
