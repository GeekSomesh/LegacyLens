# systemd unit that keeps the LegacyLens container running (podman).
#   sudo cp deploy/legacylens.service /etc/systemd/system/ && sudo systemctl enable --now legacylens
[Unit]
Description=LegacyLens API container
After=network-online.target granite.service

[Service]
User=linux1
ExecStartPre=-/usr/bin/podman rm -f legacylens
ExecStart=/usr/bin/podman run --rm --name legacylens --network host -v /home/linux1/data:/data:ro -e "LEGACYLENS_DATA=/data/default of credit card clients.xls" localhost/legacylens:latest
ExecStop=/usr/bin/podman stop legacylens
Restart=on-failure

[Install]
WantedBy=multi-user.target
